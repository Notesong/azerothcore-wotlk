 QH_Event("UNIT_QUEST_LOG_CHANGED", UpdateTrigger)
 QH_Event("QUEST_LOG_UPDATE", QH_UpdateQuests)
 
+-- Purchases and other bag changes can update objective counts without a quest
+-- log event. Let the inventory settle, then use the normal quest-log scan.
+local inventory_update_pending = false
+local function InventoryUpdateTrigger()
+  if inventory_update_pending then return end
+  inventory_update_pending = true
+  QH_AddNotifier(GetTime() + 0.1, function()
+    inventory_update_pending = false
+    QH_UpdateQuests(true)
+  end)
+end
+
+QH_Event("BAG_UPDATE", InventoryUpdateTrigger)
+QH_Event("UNIT_INVENTORY_CHANGED", function(unit)
+  if unit == "player" then InventoryUpdateTrigger() end
+end)
+
